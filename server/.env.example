OPENAI_API_KEY=replace_with_server_secret
OPENAI_MODEL=gpt-4.1-mini
PORT=8787
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
CUE_CLOUD_REQUIRED=0
# 선택: 카카오 로컬 REST API 키. 있으면 행사장을 지도의 실제 장소로 찾아 연결합니다.
KAKAO_REST_API_KEY=
# 선택: 서울 열린데이터광장 인증키. 있으면 서울시 문화행사를 매일 추천 후보로 가져옵니다.
SEOUL_OPEN_API_KEY=
# 선택: 공공데이터포털 한국관광공사 TourAPI 인증키(디코딩). 있으면 전국 축제를 매일 가져옵니다.
TOUR_API_KEY=
# 선택: 매일 웹 검색으로 찾을 분야(쉼표로 구분, 한 분야당 OpenAI 웹 검색 1회).
DISCOVERY_DAILY_TOPICS=기술,강연,채용·커리어,팝업스토어,스포츠,워크숍,지역 축제,음악 페스티벌,푸드 페스티벌
# Optional: set a separate secret to enable catalog imports and the daily refresh.
CATALOG_ADMIN_TOKEN=

# 1이면 시연용 예시 행사를 채우고 관심사가 없어도 행사를 추천합니다.
CUE_DEMO_MODE=0
